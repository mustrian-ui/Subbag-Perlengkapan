{
  "entities": {
    "LandingContent": {
      "title": "LandingContent",
      "description": "Customizable homepage sections and texts",
      "type": "object",
      "properties": {
        "heroTagline": { "type": "string" },
        "heroTitlePrefix": { "type": "string" },
        "heroTitleAccent": { "type": "string" },
        "heroDesc": { "type": "string" },
        "heroBgUrl": { "type": "string" },
        "heroPhone": { "type": "string" },
        "visiMisiSubtitle": { "type": "string" },
        "visiTitle": { "type": "string" },
        "visiText": { "type": "string" },
        "misiSubtitle": { "type": "string" },
        "misiTitle": { "type": "string" },
        "misiItems": { "type": "array" }
      },
      "required": ["heroTagline", "heroTitlePrefix", "heroTitleAccent", "heroDesc", "heroBgUrl"]
    },
    "Application": {
      "title": "Application",
      "description": "Active systems/applications in Setda Tarakan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "icon": { "type": "string" },
        "desc": { "type": "string" }
      },
      "required": ["id", "title", "category", "icon", "desc"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Documented snapshot and activities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["id", "title", "category", "date", "url"]
    },
    "Booking": {
      "title": "Booking",
      "description": "SIPERUM Room Booking reservations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ruang": { "type": "string" },
        "tanggal": { "type": "string" },
        "waktu": { "type": "string" },
        "agenda": { "type": "string" },
        "status": { "type": "string" },
        "documentUrl": { "type": "string" },
        "documentName": { "type": "string" },
        "pemohon": { "type": "string" },
        "instansi": { "type": "string" }
      },
      "required": ["id", "ruang", "tanggal", "waktu", "agenda", "status"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "SIPAKAR Vehicle booking requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kendaraan": { "type": "string" },
        "pemohon": { "type": "string" },
        "tujuan": { "type": "string" },
        "status": { "type": "string" },
        "documentUrl": { "type": "string" },
        "documentName": { "type": "string" },
        "instansi": { "type": "string" }
      },
      "required": ["id", "kendaraan", "pemohon", "tujuan", "status"]
    },
    "LogisticsRequest": {
      "title": "LogisticsRequest",
      "description": "SILOGIS Inventory & logistics requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "barang": { "type": "string" },
        "jumlah": { "type": "string" },
        "status": { "type": "string" },
        "documentUrl": { "type": "string" },
        "documentName": { "type": "string" },
        "kegiatan": { "type": "string" },
        "pemohon": { "type": "string" },
        "instansi": { "type": "string" }
      },
      "required": ["id", "barang", "jumlah", "status"]
    },
    "SajiRapatRequest": {
      "title": "SajiRapatRequest",
      "description": "SajiRapat official meeting food & beverage catering requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "acara": { "type": "string" },
        "tanggal": { "type": "string" },
        "waktu": { "type": "string" },
        "lokasi": { "type": "string" },
        "pemohon": { "type": "string" },
        "nip": { "type": "string" },
        "kontak": { "type": "string" },
        "instansi": { "type": "string" },
        "porsi": { "type": "string" },
        "jenisKonsumsi": { "type": "string" },
        "catatan": { "type": "string" },
        "status": { "type": "string" },
        "documentUrl": { "type": "string" },
        "documentName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "acara", "tanggal", "waktu", "pemohon", "instansi", "porsi", "jenisKonsumsi", "status"]
    },
    "CinderamataRequest": {
      "title": "CinderamataRequest",
      "description": "PetaCendera souvenir and honorary plaques requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "keperluan": { "type": "string" },
        "tanggalPerlu": { "type": "string" },
        "pemohon": { "type": "string" },
        "nip": { "type": "string" },
        "kontak": { "type": "string" },
        "instansi": { "type": "string" },
        "penerima": { "type": "string" },
        "jenisCinderamata": { "type": "string" },
        "jumlah": { "type": "string" },
        "catatan": { "type": "string" },
        "status": { "type": "string" },
        "documentUrl": { "type": "string" },
        "documentName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "keperluan", "tanggalPerlu", "pemohon", "instansi", "penerima", "jenisCinderamata", "jumlah", "status"]
    },
    "HallSchedule": {
      "title": "HallSchedule",
      "description": "Jadwal Penggunaan Gedung Serba Guna",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hariTanggal": { "type": "string" },
        "kegiatan": { "type": "string" },
        "instansi": { "type": "string" },
        "keterangan": { "type": "string" }
      },
      "required": ["id", "hariTanggal", "kegiatan", "instansi", "keterangan"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Laporan pengaduan sarana dan prasarana (LAPOR-RT)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nip": { "type": "string" },
        "bagian": { "type": "string" },
        "type": { "type": "string" },
        "location": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["Masuk", "Diproses", "Selesai"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "bagian", "type", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "settings/landing": {
      "schema": "LandingContent",
      "description": "Single document holding the customizable page copy"
    },
    "applications/{appId}": {
      "schema": "Application",
      "description": "Dynamic service micro-applications"
    },
    "gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Documented activities gallery"
    },
    "bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Room reservations"
    },
    "vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Armada car reservations"
    },
    "logistics/{logisticsId}": {
      "schema": "LogisticsRequest",
      "description": "Logistics and item requirements"
    },
    "sajirapat/{sajirapatId}": {
      "schema": "SajiRapatRequest",
      "description": "Meeting catering and refreshments logistics"
    },
    "cinderamata/{cinderamataId}": {
      "schema": "CinderamataRequest",
      "description": "Souvenirs, plaques, and honorary gift allocations"
    },
    "schedules/{scheduleId}": {
      "schema": "HallSchedule",
      "description": "Shared hall/building schedules"
    },
    "complaints/{complaintId}": {
      "schema": "Complaint",
      "description": "Incoming user reports and complaints (LAPOR-RT)"
    }
  }
}
