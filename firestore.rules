rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Connectivity test collection
    match /test/{testId} {
      allow read: if true;
    }

    // Settings collection for landing page customization
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Applications list
    match /applications/{appId} {
      allow read, write: if true;
    }

    // Gallery item list
    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    // Bookings (SIPERUM) list
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Vehicles (SIPAKAR) list
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // Logistics (SILOGIS) list
    match /logistics/{logisticsId} {
      allow read, write: if true;
    }

    // SajiRapat (Fasilitasi Konsumsi Rapat) list
    match /sajirapat/{sajirapatId} {
      allow read, write: if true;
    }

    // PetaCendera (Permintaan & Pengelolaan Cinderamata) list
    match /cinderamata/{cinderamataId} {
      allow read, write: if true;
    }

    // Schedules (Jadwal Gedung GSG) list
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Complaints (LAPOR-RT / Pengaduan Masyarakat & Pegawai)
    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    // Catch-all rule for general safety
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
